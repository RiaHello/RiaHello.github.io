# Copy to .env, replace placeholders, and never commit the result.
DEEPSEEK_API_KEY=replace-with-your-backend-only-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
REDIS_URL=redis://127.0.0.1:6379/0
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
RATE_LIMIT_HMAC_SECRET=replace-with-a-random-at-least-32-character-ASCII-secret
